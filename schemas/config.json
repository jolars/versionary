{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jolars/versionary/main/schemas/config.json",
  "title": "Versionary configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "review-mode": {
      "type": "string",
      "enum": ["direct", "pr", "review"]
    },
    "version-file": {
      "type": "string"
    },
    "changelog-file": {
      "type": "string"
    },
    "changelog-format": {
      "type": "string",
      "enum": ["markdown-changelog", "r-news"]
    },
    "release-draft": {
      "type": "boolean"
    },
    "release-reference-comments": {
      "type": "string",
      "enum": ["off", "best-effort", "strict"]
    },
    "release-branch": {
      "type": "string"
    },
    "baseline-file": {
      "type": "string"
    },
    "next-release-file": {
      "type": "string"
    },
    "bootstrap-sha": {
      "type": "string"
    },
    "monorepo-mode": {
      "type": "string",
      "enum": ["independent", "fixed"]
    },
    "bump-minor-pre-major": {
      "type": "boolean"
    },
    "allow-stable-major": {
      "type": "boolean"
    },
    "include-commit-authors": {
      "type": "boolean"
    },
    "exclude-paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "release-type": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "release-type": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "package-name": {
            "type": "string"
          },
          "changelog-file": {
            "type": "string"
          },
          "changelog-format": {
            "type": "string",
            "enum": ["markdown-changelog", "r-news"]
          },
          "allow-stable-major": {
            "type": "boolean"
          },
          "exclude-paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extra-files": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["json", "toml", "yaml", "nix"]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "field-path": {
                      "type": "string"
                    },
                    "jsonpath": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "path"],
                  "anyOf": [
                    {
                      "required": ["field-path"]
                    },
                    {
                      "required": ["jsonpath"]
                    }
                  ],
                  "not": {
                    "required": ["field-path", "jsonpath"]
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "regex"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "replacement": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "path", "pattern"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "follows": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["version"],
  "additionalProperties": false
}
